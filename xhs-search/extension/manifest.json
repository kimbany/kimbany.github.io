{
  "manifest_version": 3,
  "name": "샤오홍슈 검색기 헬퍼",
  "short_name": "XHS Helper",
  "version": "1.0.2",
  "description": "kimbany.github.io/xhs-search/ 에서 본인 브라우저 세션으로 샤오홍슈 검색 결과를 가져옵니다.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kimbany.github.io/*",
        "https://invedory.com/*",
        "https://www.invedory.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "샤오홍슈 검색기 헬퍼 — 활성화됨"
  }
}
