{
  "manifest_version": 3,
  "name": "샤오홍슈 검색기 헬퍼",
  "short_name": "XHS Helper",
  "version": "1.0.6",
  "description": "invedory.com/xhs-search/ 에서 본인 브라우저 세션으로 샤오홍슈 검색 + YouTube 영상 데이터를 가져옵니다.",
  "permissions": ["cookies", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "https://*.youtube.com/*",
    "https://*.ytimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kimbany.github.io/*",
        "https://invedory.com/*",
        "https://www.invedory.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["xhs-page-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["xhs-page-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["yt-page-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["yt-page-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "샤오홍슈 검색기 헬퍼 — 활성화됨"
  }
}

