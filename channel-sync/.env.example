# ─────────────────────────────────────────────────────────────
# channel-sync 환경변수  ( cp .env.example .env  후 채워넣기 )
# 값이 비어 있는 채널은 자동으로 건너뜁니다.
# ─────────────────────────────────────────────────────────────

# 수집 대상 (쉼표 구분). 비우면 키가 채워진 채널 전부.
CHANNELS=

# 기본 조회 기간 (일). --from/--to 를 안 주면 오늘 기준 최근 N일.
LOOKBACK_DAYS=1

# ── 쿠팡 (WING > 판매자정보 > 오픈API 키 발급) ────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# ── 네이버 스마트스토어 (커머스API센터 > 애플리케이션) ────────
# ※ 커머스API는 호출 IP 사전 등록 필요 → 고정 IP에서 실행할 것
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=

# ── 11번가 (셀러오피스 > 오픈API 키) ──────────────────────────
ELEVENST_API_KEY=

# ── 카페24 자사몰 (개발자센터 앱 > OAuth) ─────────────────────
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REFRESH_TOKEN=
CAFE24_API_VERSION=2024-06-01

# ── ESM (옥션/지마켓) — 마스터ID + API 신청 후 발급 ───────────
ESM_API_KEY=
ESM_MASTER_ID=

# ── 토스쇼핑 — 셀러센터 '내 연동 키' ──────────────────────────
TOSS_SHOPPING_API_KEY=
