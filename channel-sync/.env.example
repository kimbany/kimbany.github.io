# ─────────────────────────────────────────────────────────────
# 카페24 적립금 현황 환경변수 — PC 에서 돌릴 때만 필요
# (처음이면 node src/cafe24-auth.js 가 질문하면서 이 파일을 만들어 줍니다)
# 매일 자동 수집(깃허브)은 저장소 비밀값을 씁니다 — README 참고
# ─────────────────────────────────────────────────────────────

# ── 카페24 (개발자센터 앱 > 인증정보) ─────────────────────────
CAFE24_MALL_ID=daseong24
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REFRESH_TOKEN=
# 개발자센터 앱에 등록한 Redirect URI 와 똑같이 (node src/cafe24-auth.js 연결에 사용)
CAFE24_REDIRECT_URI=https://invedory.com/
# 비워 두면 앱 기본 버전 (개발자센터 앱 설정의 버전)
CAFE24_API_VERSION=
# 기본 조회 기간 (일). --from/--to 를 안 주면 오늘 기준 최근 N일
POINTS_LOOKBACK_DAYS=30

# ── Firebase (DB · 매출 리포트와 같은 monfruit-sales 계정) ──────
# 비우면 sales-report/index.html 의 firebaseConfig.apiKey 를 자동으로 씁니다
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=monfruit-sales
FIREBASE_EMAIL=owner@monfruit-sales.web
# 매출 리포트 비밀번호 앞에 mf 를 붙인 값 (예: 1234 → mf1234). 비우면 처음 실행할 때 물어봅니다
FIREBASE_PASSWORD=
